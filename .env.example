# =============================================================================
# .env.example — Automações Hub v6.5.4
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o .env com valores reais.
# =============================================================================

# --- Oracle ---
ORACLE_READONLY_USER=<PREENCHER>
ORACLE_READONLY_PASSWORD=<PREENCHER>
ORACLE_CONNECT_STRING=<HOST>:<PORTA>/<SERVICE_NAME>
ORACLE_CLIENT_PATH=<CAMINHO_ABSOLUTO_DO_CLIENT_ORACLE>
ORACLE_CLIENT_LIB_DIR=<CAMINHO_ABSOLUTO_DO_CLIENT_ORACLE>
TNS_ADMIN=<CAMINHO_DO_NETWORK_ADMIN>
ORACLE_READONLY_POOL_ALIAS=readonly

# --- E-mail ---
AUTOMACAO_TEST_EMAIL=<EMAIL_PARA_TESTES>
AUTOMACAO_ALERT_EMAIL=<EMAIL_PARA_ALERTAS>

# Destinatários de e-mail por automação (nunca versionados em config.json).
# Múltiplos endereços separados por "; ".
MT_EMAIL_TO=<DESTINATARIOS_MONTAGEM_TERCEIRIZADOS>
MT_EMAIL_CC=<COPIA_MONTAGEM_TERCEIRIZADOS>
RB_EMAIL_TO=<DESTINATARIOS_RECEITAS_BLOQUEADAS>
RB_EMAIL_CC=<COPIA_RECEITAS_BLOQUEADAS>
RE_EMAIL_TO=<DESTINATARIOS_RECEITAS_EMITIDAS>

# --- Alvos WhatsApp por automação (nunca versionados em whatsapp-config.json) ---
# OBP-04: ID de grupo no formato <numero>-<timestamp>@g.us
# RB-01: contato individual no formato <numero>@c.us
# OFST-06: grupo "Expedição Tinturaria". Descobrir o ID com:
#   node lib\WhatsApp-Core.js manual LIST_GROUPS hub-global
OBP_WHATSAPP_TARGET=<ID_GRUPO_WHATSAPP_OBP>
RB_WHATSAPP_TARGET=<CONTATO_WHATSAPP_RECEITAS_BLOQUEADAS>
OFST_WHATSAPP_TARGET=<ID_GRUPO_WHATSAPP_EXPEDICAO_TINTURARIA>

# --- Orchestrator ---
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
ORCHESTRATOR_API_KEY=<GERAR_CHAVE_SEGURA>
HUB_API_PORT=8000
WORKER_MAX_CONCURRENCY=4
EXECUTION_RETENTION_DAYS=90
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8000,http://127.0.0.1:8000

# --- Encoding ---
PYTHONIOENCODING=utf-8
PYTHONUTF8=1

# --- Rate Limit ---
RATE_LIMIT_RPM=600

# --- Integrações (opcionais) ---
# GITHUB_PERSONAL_ACCESS_TOKEN=<TOKEN_GITHUB>

# --- OBs Paradas Fase (OBP-04) — contatos operacionais ---
# Números reais de responsáveis por turno/equipe, nunca versionados em config.json.
# equipe_cq aceita múltiplos números separados por vírgula.
OBP_CONTATO_LIDER_1_TURNO=<NUMERO_LIDER_1_TURNO>
OBP_CONTATO_LIDER_RESERVA_1_TURNO=<NUMERO_LIDER_RESERVA_1_TURNO>
OBP_CONTATO_LIDER_2_TURNO=<NUMERO_LIDER_2_TURNO>
OBP_CONTATO_LIDER_RESERVA_2_TURNO=<NUMERO_LIDER_RESERVA_2_TURNO>
OBP_CONTATO_LIDER_3_TURNO=<NUMERO_LIDER_3_TURNO>
OBP_CONTATO_LIDER_RESERVA_3_TURNO=<NUMERO_LIDER_RESERVA_3_TURNO>
OBP_CONTATO_EQUIPE_CQ=<NUMERO_1>,<NUMERO_2>,<NUMERO_3>
