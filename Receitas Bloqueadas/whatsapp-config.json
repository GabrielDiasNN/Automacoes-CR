    "keepFailureForMs": 604800000
  },
  "terminal": {
    "showQr": true
  },
  "auth": {
    "clientId": "hub-global"
  },
  "runtime": {
    "headless": true
  },
  "retry": {
    "enabled": true,
    "maxAttempts": 2,
    "attemptDelayMs": 2000,
    "sendSettleMs": 5000,
    "finalWaitMs": 2000,
    "initTimeoutMs": 60000
