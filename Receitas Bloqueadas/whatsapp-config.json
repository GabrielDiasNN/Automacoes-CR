{
  "app": {
    "enabled": true
  },
  "paths": {
    "attachmentPath": "Receitas Bloqueadas.xlsx",
    "logFile": "Logs\\ReceitasBloqueadas.log",
    "stateFile": "whatsapp-state.json"
  },
  "_comentario_target": "Destino real vem de RB_WHATSAPP_TARGET no .env (não versionado). contactId/contactPhone abaixo são apenas placeholder/fallback.",
  "target": {
    "enabled": true,
    "type": "contact",
    "groupName": "",
    "contactIdEnv": "RB_WHATSAPP_TARGET",
    "contactPhone": "550000000000",
    "contactId": "550000000000@c.us",
    "mentions": {
      "enabled": false,
      "list": []
    }
  },
  "message": {
    "sendAttachment": true,
    "caption": {
      "enabled": true,
      "title": {
        "enabled": true,
        "text": "Receitas Bloqueadas"
      },
      "body": {
        "enabled": true,
        "text": "Segue planilha atualizada em anexo."
      },
      "execId": {
        "enabled": false,
        "label": "Execucao:",
        "fallback": "sem-exec-id"
      }
    }
  },
  "idempotency": {
    "enabled": true,
    "retryFailedAfterMs": 0,
