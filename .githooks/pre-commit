#!/usr/bin/env sh
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
SCRIPT_PATH="$REPO_ROOT/Tools/Test-PowerShellApprovedVerbs.ps1"

if [ ! -f "$SCRIPT_PATH" ]; then
  echo "[WARN] Script de validacao nao encontrado: $SCRIPT_PATH"
  exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_PATH"
  exit $?
fi

if command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$SCRIPT_PATH"
  exit $?
fi

echo "[ERRO] PowerShell nao encontrado. Commit bloqueado."
exit 1
