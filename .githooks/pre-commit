#!/usr/bin/env sh
# {
#   "version": "9.3.3",
#   "skill": "automation-runtime-safety",
#   "description": "Pre-commit hook simplificado com delegacao soberana para auto-resolucao no PowerShell"
# }
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
VALIDAR_AUTO_PATH="$REPO_ROOT/Tools/ValidarAutomacoes.ps1"

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "[ERRO] PowerShell nao encontrado. Commit bloqueado."
  exit 1
fi

echo "=== INICIANDO GOVERNANCA NATIVA AUTOMATIZADA (PRE-COMMIT) ==="

if [ -f "$VALIDAR_AUTO_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$VALIDAR_AUTO_PATH" -BasePath "$REPO_ROOT" -OnlyGovernance -StagedOnly
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "[ERRO] Falha na validacao de Governanca. Commit abortado."
    exit 1
  fi
else
  echo "[AVISO] Orquestrador de governanca nao encontrado em $VALIDAR_AUTO_PATH."
fi

echo "[OK] Governanca aprovada. Pronta para commit."
exit 0
