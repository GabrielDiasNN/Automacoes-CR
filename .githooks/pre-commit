#!/usr/bin/env sh
# {
#   "version": "4.0.0",
#   "skill": "automation-runtime-safety",
#   "description": "Pre-commit hook focado em stack 100% Nativa com orquestrador de validacao e otimizacao em staged files"
# }
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
VALIDAR_AUTO_PATH="$REPO_ROOT/Tools/ValidarAutomacoes.ps1"

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "[ERRO] PowerShell nao encontrado. Commit bloqueado."
  exit 1
fi

echo "=== INICIANDO ORQUESTRADOR DE GOVERNANCA NATIVA (PRE-COMMIT) ==="

# Pegamos apenas arquivos adicionados, copiados ou modificados na staged area
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
  echo "[OK] Nenhum arquivo alterado na staged area para validar."
  exit 0
fi

# Transforma as quebras de linha em virgulas para passar como array no powershell
STAGED_FILES_CSV=$(echo "$STAGED_FILES" | tr '\n' ',' | sed 's/,$//')

if [ -f "$VALIDAR_AUTO_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -Command "& '$VALIDAR_AUTO_PATH' -BasePath '$REPO_ROOT' -OnlyGovernance -Paths ('$STAGED_FILES_CSV' -split ',')"
  
  if [ $? -ne 0 ]; then
    echo ""
    echo "[ERRO] Falha na validacao de Governanca. Verifique os logs acima."
    exit 1
  fi
else
  echo "[AVISO] Orquestrador de governanca nao encontrado em $VALIDAR_AUTO_PATH."
fi

echo "[OK] Governanca aprovada e pronta para commit."
exit 0
