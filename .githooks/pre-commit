#!/usr/bin/env sh
# {
#   "version": "3.2.0",
#   "skill": "automation-runtime-safety",
#   "description": "Pre-commit hook focado em stack 100% Nativa (Soberana) com validacao JSON e suporte UTF-8"
# }
set -eu

REPO_ROOT="$(git rev-parse --show-toplevel)"
VERBS_SCRIPT_PATH="$REPO_ROOT/Tools/Test-PowerShellApprovedVerbs.ps1"
SKILLS_SCRIPT_PATH="$REPO_ROOT/Tools/Test-SkillsGovernance.ps1"
VALIDAR_AUTO_PATH="$REPO_ROOT/Tools/ValidarAutomacoes.ps1"
ZT_SCRIPT_PATH="$REPO_ROOT/Tools/Test-ZeroTrust.ps1"
PY_GOV_PATH="$REPO_ROOT/Tools/Test-PythonGovernance.ps1"
SQL_GOV_PATH="$REPO_ROOT/Tools/Test-SqlPerformance.ps1"
PS_GOV_PATH="$REPO_ROOT/Tools/Test-PowerShellGovernance.ps1"
PORT_GOV_PATH="$REPO_ROOT/Tools/Test-PortablePaths.ps1"
JSON_GOV_PATH="$REPO_ROOT/Tools/Test-JsonConfig.ps1"
ORCH_GOV_PATH="$REPO_ROOT/Tools/Test-OrchestratorIntegrity.ps1"

if command -v pwsh >/dev/null 2>&1; then
  PS_BIN="pwsh"
elif command -v powershell >/dev/null 2>&1; then
  PS_BIN="powershell"
else
  echo "[ERRO] PowerShell nao encontrado. Commit bloqueado."
  exit 1
fi

echo "=== INICIANDO GOVERNANCA NATIVA (PRE-COMMIT) ==="

# 1. Seguranca Zero Trust
if [ -f "$ZT_SCRIPT_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$ZT_SCRIPT_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 2. Portabilidade
if [ -f "$PORT_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$PORT_GOV_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 3. Sintaxe JSON
if [ -f "$JSON_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$JSON_GOV_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 4. Performance SQL
if [ -f "$SQL_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$SQL_GOV_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 5. Governanca Python
if [ -f "$PY_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$PY_GOV_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 6. Governanca PowerShell
if [ -f "$PS_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$PS_GOV_PATH" -RootPath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 7. Metadados e Verbos
if [ -f "$SKILLS_SCRIPT_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$SKILLS_SCRIPT_PATH" -BasePath "$REPO_ROOT"
  if [ $? -ne 0 ]; then exit 1; fi
fi

if [ -f "$VERBS_SCRIPT_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$VERBS_SCRIPT_PATH"
  if [ $? -ne 0 ]; then exit 1; fi
fi

# 8. Integridade do Orquestrador
if [ -f "$ORCH_GOV_PATH" ]; then
  "$PS_BIN" -NoProfile -ExecutionPolicy Bypass -File "$ORCH_GOV_PATH"
  if [ $? -ne 0 ]; then exit 1; fi
fi

echo "[OK] Governanca aprovada."
exit 0
