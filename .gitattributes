# Normalizacao padrao: Git decide o EOL correto por plataforma
* text=auto

# Forcar CRLF para arquivos VBA (essencial para importacao correta no Excel/VBE)
*.cls text eol=crlf
*.bas text eol=crlf
*.vbs text eol=crlf

# Padrao para outros scripts
*.ps1 text eol=crlf working-tree-encoding=UTF-8
*.psm1 text eol=crlf working-tree-encoding=UTF-8
*.psd1 text eol=crlf working-tree-encoding=UTF-8
*.bat text eol=crlf
*.cmd text eol=crlf
*.js text eol=lf working-tree-encoding=UTF-8
*.py text eol=lf working-tree-encoding=UTF-8
*.css text eol=lf working-tree-encoding=UTF-8
*.html text eol=lf working-tree-encoding=UTF-8
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf working-tree-encoding=UTF-8
*.toml text eol=lf
*.json text working-tree-encoding=UTF-8
*.md text working-tree-encoding=UTF-8

# Binarios (sem normalizacao nem diff textual)
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.xlsx binary
*.xlsm binary
*.db binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary
