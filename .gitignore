# { "version": "2.1.0", "skill": "ai-native-development-standard", "description": "Global Repository Hygiene" }

# Ambientes Virtuais e Trash
.venv/*
.venv*/
.venv_old/
.venv_trash/
node_modules/
npm-debug.log*
playwright-report/
test-results/

# Artefatos de build e compressão
*.zip
*.7z
*.rar
artifacts/

# pip-tools
requirements*.txt
!requirements.txt
!requirements-dev.txt
!requirements-test.txt

# Logs e Artefatos Temporários
Logs/
*.log
*.tmp
*.bak
Startup_Error.txt

# Cobertura de testes
.coverage
htmlcov/

# Dashboard gerado/exportado (nao confundir com SPA fonte em Dashboard/)
Dashboard/dashboard.html

# Caches de Inteligência e Estado
.cache_erros.json
**/__pycache__/
.mypy_cache/
**/.pytest_cache/
.pytest_cache/
.gemini/
.playwright-mcp/
.playwright-cli/
email_body.html

# Excel Temporários e Lock
~$*.xlsm
~$*.xlsx
**/.sendwhatsapp.lock/

# WhatsApp Session
.wwebjs_auth/
.wwebjs_cache/

# Auditoria
Audit/

# Regras de Binários XLSM
*.xlsm
*.xlsx

# Exceções: Apenas arquivos oficiais de produção/extração híbrida
!Montagem de Terceirizados/Legacy/Validador_Notas_Montagem.xlsm
!Receitas Emitidas/Controle de Receitas Emitidas.xlsm

# Segredos (CRÍTICO)
.env
*.pem
*.key
.aider*

# Banco de Dados SQLite (runtime — nao versionar)
Orchestrator/automacoes.db
Orchestrator/automacoes.db-shm
Orchestrator/automacoes.db-wal
Orchestrator/orchestrator.db
Orchestrator/orchestrator.db-shm
Orchestrator/orchestrator.db-wal
Orchestrator/tests/test-*.db
Orchestrator/tests/test-*.db-shm
Orchestrator/tests/test-*.db-wal
Orchestrator/tests/fix_tests*.py
Orchestrator/orchestrator.pid
Orchestrator/worker.pid
Backups/

# Scratch local de investigação
scratch/

# Estados runtime por automacao (nao versionar)
Montagem de Terceirizados/delivery_state.json
Receitas Bloqueadas/email_state.json
Receitas Bloqueadas/receitas_state.json
Receitas Emitidas/delivery_state.json
Receitas Emitidas/receitas_state.json
