# { "version": "2.0.0", "skill": "ai-native-development-standard", "description": "Global Repository Hygiene" }

# Logs e Artefatos Temporários
**/Logs/
*.log
Startup_Error.txt
Dashboard/

# Caches de Inteligência e Estado
.cache_erros.json
**/__pycache__/
.pytest_cache/
.gemini/

# Excel Temporários e Lock
~$*.xlsm
~$*.xlsx
**/.sendwhatsapp.lock/

# WhatsApp Session
.wwebjs_auth/
.wwebjs_cache/

# Auditoria
Audit/

# Regras de Binários XLSM
*.xlsm
*.xlsx

# Exceções: Apenas arquivos oficiais de produção/extração híbrida
!Montagem de Terceirizados/Legacy/Validador_Notas_Montagem.xlsm
!Receitas Bloqueadas/Receitas Bloqueadas.xlsm
!Receitas Emitidas/Controle de Receitas Emitidas.xlsm

# Segredos (CRÍTICO)
.env
*.pem
*.key
.aider*
