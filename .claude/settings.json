{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$data = $env:CLAUDE_TOOL_INPUT | ConvertFrom-Json; $f = $data.file_path; if ($f -and $f.EndsWith('.py')) { python -m black $f 2>&1; python -m isort $f 2>&1 }",
            "shell": "powershell",
            "statusMessage": "Formatando Python (black + isort)...",
            "async": true
          },
          {
            "type": "command",
            "command": "& \"$(if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { $PWD.Path })\\.claude\\hooks\\Assert-FileEncoding.ps1\"",
            "shell": "powershell",
            "statusMessage": "Verificando encoding (BOM)...",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "$data = $env:CLAUDE_TOOL_INPUT | ConvertFrom-Json; $f = $data.file_path; if ($f -and $f -match 'Dashboard[/\\\\]src') { npm run lint:js 2>&1 }",
            "shell": "powershell",
            "statusMessage": "ESLint Dashboard/src...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$(if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { $PWD.Path })\\.claude\\hooks\\Register-GateRun.ps1\"",
            "shell": "powershell",
            "statusMessage": "Registrando execucao de gate...",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "& \"$(if ($env:CLAUDE_PROJECT_DIR) { $env:CLAUDE_PROJECT_DIR } else { $PWD.Path })\\.claude\\hooks\\Assert-StopQualityGate.ps1\"",
            "shell": "powershell",
            "statusMessage": "Verificando gates pendentes...",
            "timeout": 45
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$data = $env:CLAUDE_TOOL_INPUT | ConvertFrom-Json; $f = $data.file_path; $blocked = @('.env', 'automacoes.db', 'orchestrator.db', 'orchestrator.pid', 'worker.pid'); foreach ($b in $blocked) { if ($f -and $f.EndsWith($b)) { Write-Error \"BLOQUEADO: arquivo sensivel nao pode ser editado pelo agente: $f\"; exit 1 } }",
            "shell": "powershell"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "claude-code-setup@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  }
}
